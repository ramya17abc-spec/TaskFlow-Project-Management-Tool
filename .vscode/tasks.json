{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TaskFlow: Run API",
      "type": "shell",
      "command": "mvn",
      "args": ["-f", "backend/pom.xml", "spring-boot:run"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TaskFlow: Run frontend",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
